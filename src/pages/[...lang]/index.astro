---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/sections/Hero.astro";
import About from "../../components/sections/About.astro";
import Services from "../../components/sections/Services.astro";
import Cases from "../../components/sections/Cases.astro";
import Team from "../../components/sections/Team.astro";
import Reviews from "../../components/sections/Reviews.astro";
import ConsultTeaser from "../../components/sections/ConsultTeaser.astro";
import Faq from "../../components/sections/Faq.astro";
import Contacts from "../../components/sections/Contacts.astro";
import { DEFAULT_LANG, LANGS, tr } from "../../lib/i18n.ts";
import type { Lang } from "../../lib/i18n.ts";
import { getContent } from "../../lib/content.ts";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang: lang === DEFAULT_LANG ? undefined : lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { settings, faq } = getContent();
---

<Base lang={lang} page="home" title={tr(settings.seo.title, lang)} description={tr(settings.seo.description, lang)}>
  <Hero lang={lang} />
  <About lang={lang} />
  <Services lang={lang} />
  <Cases lang={lang} />
  <Team lang={lang} />
  <Reviews lang={lang} />
  <ConsultTeaser lang={lang} />
  <Faq lang={lang} id="faq" content={faq} messenger="telegram" />
  <Contacts lang={lang} />
</Base>
