---
interface Props {
  overline?: string;
  title: string;
  subtitle?: string;
  id?: string;
  class?: string;
}

const { overline, title, subtitle, id, class: className } = Astro.props;
---

<div class:list={["section-title", className]}>
  {overline && <p class="t-overline">{overline}</p>}
  <h2 class="t-h1" id={id} set:html={title} />
  {subtitle && <p class="t-body-l">{subtitle}</p>}
</div>
