---
import Icon from "../ui/Icon.astro";
import Btn from "../ui/Btn.astro";
import Dialog from "../ui/Dialog.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import { tr, url } from "../../lib/i18n.ts";
import type { Lang } from "../../lib/i18n.ts";
import { getContent } from "../../lib/content.ts";
import { sectionVisibility } from "../../lib/nav.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { services, ui, home } = getContent();
const ctaLabel = tr(home.hero.button, lang);
const practices = services.practices.map((p, i) => ({ ...p, dialog: `practice-${i + 1}` }));
---

{
  sectionVisibility().services && (
    <section class="section" id="services" aria-labelledby="services-title">
      <div class="container">
        <SectionTitle id="services-title" lang={lang} head={services} />

        {services.general.items.length > 0 && (
          <div class="general glass">
            <p class="t-overline">{tr(services.general.title, lang)}</p>
            <ul class="general__list">
              {services.general.items.map((g) => (
                <li class="t-body-s">
                  <Icon name="check" size={16} />
                  <span>{tr(g, lang)}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <ul class="practices">
          {practices.map((p) => (
            <li class="practice glass card card--hover">
              <span class="icon-box">
                <Icon name={p.icon} />
              </span>
              <h3 class="t-h4 practice__title">{tr(p.title, lang)}</h3>
              <p class="t-body-s t-pre c-secondary practice__desc">{tr(p.description, lang)}</p>
              <p class="t-body-s c-secondary practice__short">{tr(p.short, lang)}</p>
              {p.items.length > 0 && (
                <>
                  <Btn variant="ghost" size="s" class="practice__more" data-dialog-open={p.dialog} aria-haspopup="dialog">
                    {tr(ui.buttons.more, lang)}
                  </Btn>
                  <button type="button" class="practice__hit" data-dialog-open={p.dialog} aria-label={`${tr(p.title, lang)} — ${tr(ui.buttons.more, lang)}`} />
                  <Icon name="arrow-right" class="practice__arrow" />
                </>
              )}
            </li>
          ))}
        </ul>

        <div class="services-cta glass-strong">
          <div class="services-cta__text">
            <h3 class="t-h4">{tr(services.cta.title, lang)}</h3>
            <p class="t-body-m t-pre c-secondary">{tr(services.cta.text, lang)}</p>
          </div>
          <Btn href={url(lang, "consultation")}>{ctaLabel}</Btn>
        </div>
      </div>

      {practices
        .filter((p) => p.items.length > 0)
        .map((p) => (
          <Dialog id={p.dialog} closeLabel={tr(ui.buttons.close, lang)}>
            <span class="icon-box" slot="head">
              <Icon name={p.icon} />
            </span>
            <h3 class="t-h3" id={`${p.dialog}-title`} slot="head">
              {tr(p.title, lang)}
            </h3>
            <p class="t-body-m t-pre c-secondary">{tr(p.description, lang)}</p>
            <p class="t-overline practice-list__title">{tr(ui.labels.practiceList, lang)}</p>
            <ul class="practice-list">
              {p.items.map((item) => (
                <li class="t-body-m">
                  <span class="icon-round icon-round--subtle practice-list__dot">
                    <Icon name="check" size={14} />
                  </span>
                  <span>{tr(item, lang)}</span>
                </li>
              ))}
            </ul>
            <Fragment slot="foot">
              <p class="t-body-s c-secondary">{tr(ui.labels.dialogCta, lang)}</p>
              <Btn href={url(lang, "consultation")} data-dialog-close>
                {ctaLabel}
              </Btn>
            </Fragment>
          </Dialog>
        ))}
    </section>
  )
}

<style>
  .general {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    border-radius: var(--radius-xl);
  }

  .general__list {
    display: grid;
    gap: 8px 24px;
  }

  .general__list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .general__list :global(.icon) {
    margin-top: 3px;
    color: var(--color-icon-accent);
  }

  .practices {
    display: grid;
    gap: 10px;
  }

  .practice {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      "icon title arrow"
      "icon short arrow";
    align-items: center;
    column-gap: 14px;
    row-gap: 2px;
    padding: 16px;
  }

  .practice .icon-box {
    grid-area: icon;
  }

  .practice__title {
    grid-area: title;
    font-size: 18px;
    align-self: end;
  }

  .practice__short {
    grid-area: short;
    align-self: start;
  }

  .practice__desc,
  .practice :global(.practice__more) {
    display: none;
  }

  .practice :global(.practice__arrow) {
    grid-area: arrow;
    --icon-size: 20px;
    color: var(--color-icon-secondary);
  }

  .practice__hit {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .services-cta {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    border-radius: var(--radius-2xl);
  }

  .services-cta__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .services-cta :global(.btn) {
    width: 100%;
  }

  .practice-list__title {
    margin: 24px 0 12px;
  }

  .practice-list {
    display: flex;
    flex-direction: column;
  }

  .practice-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .practice-list li:last-child {
    border-bottom: 0;
  }

  .practice-list__dot {
    --round-size: 24px;
    margin-top: 1px;
  }

  @media (min-width: 600px) {
    .general {
      padding: 24px 28px;
      border-radius: var(--radius-2xl);
    }

    .general__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .practices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .practice {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      min-height: 300px;
      padding: 32px;
    }

    .practice .icon-box {
      margin-bottom: 8px;
    }

    .practice__title {
      font-size: var(--fs-h4);
      align-self: auto;
    }

    .practice__desc {
      display: block;
    }

    .practice__short,
    .practice :global(.practice__arrow),
    .practice__hit {
      display: none;
    }

    .practice :global(.practice__more) {
      display: inline-flex;
      margin-top: auto;
    }

    .practice :global(.practice__more)::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: var(--radius-xl);
    }

    .services-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 24px 24px 24px 28px;
    }

    .services-cta :global(.btn) {
      width: auto;
      flex: none;
    }
  }

  @media (min-width: 1280px) {
    .general__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .practices {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .practice {
      min-height: 340px;
    }
  }
</style>
