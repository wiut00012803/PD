---
import { hasText, lines, tr } from "../../lib/i18n.ts";
import type { Lang } from "../../lib/i18n.ts";
import type { LocalizedText } from "../../content/schema.ts";

interface Props {
  id: string;
  lang: Lang;
  head: { overline: LocalizedText; title: LocalizedText; subtitle?: LocalizedText };
  class?: string;
}

const { id, lang, head, class: className } = Astro.props;
---

<div class:list={["section-title", className]}>
  <p class="t-overline">{tr(head.overline, lang)}</p>
  <h2 class="t-h1" id={id} set:html={lines(head.title, lang)} />
  {head.subtitle && hasText(head.subtitle) && <p class="t-body-l">{tr(head.subtitle, lang)}</p>}
</div>
