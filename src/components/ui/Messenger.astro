---
import Icon from "./Icon.astro";
import { contactLinks } from "../../lib/links.ts";
import { externalLink } from "../../lib/html.ts";
import { SOCIALS } from "../../content/schema.ts";

interface Props {
  platform: "telegram" | "whatsapp" | "phone";
  block?: boolean;
  class?: string;
}

const { platform, block = false, class: className } = Astro.props;
const links = contactLinks();
const PLATFORMS = {
  telegram: { href: links.telegram, label: SOCIALS.telegram, external: true },
  whatsapp: { href: links.whatsapp, label: SOCIALS.whatsapp, external: true },
  phone: { href: links.phone, label: links.phoneDisplay, external: false },
};
const { href, label, external } = PLATFORMS[platform];
---

<a href={href} class:list={["btn", "btn--messenger", "btn--m", block && "btn--block", className]} {...externalLink(external)}>
  {platform === "phone" ? <Icon name="phone" /> : <Icon social={platform} />}
  <span>{label}</span>
</a>
