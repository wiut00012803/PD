---
import { SOCIAL_ICONS, UI_ICONS } from "../../icons/icons.ts";
import type { SocialIconName, UiIconName } from "../../icons/icons.ts";

interface Props {
  name?: UiIconName;
  social?: SocialIconName;
  size?: number;
  class?: string;
}

const { name, social, size, class: className } = Astro.props;
const body = social ? SOCIAL_ICONS[social] : name ? UI_ICONS[name] : "";
const style = size ? `--icon-size:${size}px` : undefined;
const classes = ["icon", name ? `icon--${name}` : `icon--${social}`, className].filter(Boolean).join(" ");
---

{
  social ? (
    <svg class={classes} style={style} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" set:html={body} />
  ) : (
    <svg
      class={classes}
      style={style}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={body}
    />
  )
}
