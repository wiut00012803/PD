---
import { lines } from "../../lib/i18n.ts";
import type { Lang } from "../../lib/i18n.ts";
import type { LocalizedText } from "../../content/schema.ts";

interface Props {
  as: "h1" | "h2";
  id: string;
  lang: Lang;
  title: LocalizedText;
  accent: LocalizedText;
  stacked?: boolean;
  class?: string;
}

const { as: Tag, id, lang, title, accent, stacked = false, class: className } = Astro.props;
---

<Tag class={className} id={id}>
  <span set:html={lines(title, lang)} />{stacked ? <br /> : " "}<span class="gradient-text" set:html={lines(accent, lang)} />
</Tag>
