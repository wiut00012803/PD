---
import SectionTitle from "../ui/SectionTitle.astro";
import Carousel from "../ui/Carousel.astro";
import { tr } from "../../lib/i18n.ts";
import type { Lang } from "../../lib/i18n.ts";
import { getContent } from "../../lib/content.ts";
import { sectionVisibility } from "../../lib/nav.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { cases, ui } = getContent();
---

{
  sectionVisibility().cases && (
    <section class="section" id="cases" aria-labelledby="cases-title">
      <div class="container">
        <SectionTitle id="cases-title" lang={lang} head={cases} />
        <Carousel id="cases-list" count={cases.items.length} visible={cases.visible} cols={{ tablet: 1, desktop: 2 }} label={tr(cases.title, lang)} moreLabel={tr(ui.buttons.showMore, lang)}>
          {cases.items.map((c, i) => (
            <li class:list={["case glass card", i >= cases.visible && "is-hidden-extra"]}>
              <p class="t-overline">{tr(c.category, lang)}</p>
              <h3 class="t-h3 case__title">{tr(c.title, lang)}</h3>
              <div class="case__block">
                <p class="t-label">{tr(ui.labels.situation, lang)}</p>
                <p class="t-body-s t-pre c-secondary">{tr(c.situation, lang)}</p>
              </div>
              <div class="case__block">
                <p class="t-label">{tr(ui.labels.result, lang)}</p>
                <p class="t-body-s t-pre c-secondary">{tr(c.result, lang)}</p>
              </div>
            </li>
          ))}
        </Carousel>
      </div>
    </section>
  )
}

<style>
  .case {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
  }

  .case__title {
    font-size: 24px;
  }

  .case__block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  @media (min-width: 600px) {
    .case {
      padding: 32px;
    }

    .case__title {
      font-size: var(--fs-h3);
    }
  }
</style>
