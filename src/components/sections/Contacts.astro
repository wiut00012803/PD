---
import Icon from "../ui/Icon.astro";
import Btn from "../ui/Btn.astro";
import MessengerPair from "../ui/MessengerPair.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import { tr, url } from "../../lib/i18n.ts";
import type { Lang } from "../../lib/i18n.ts";
import { getContent } from "../../lib/content.ts";
import { contactLinks } from "../../lib/links.ts";
import { externalLink } from "../../lib/html.ts";
import { sectionVisibility } from "../../lib/nav.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { home, settings, ui } = getContent();
const links = contactLinks();
const rows = [
  { icon: "map-pin", label: tr(ui.labels.address, lang), value: tr(settings.address, lang), href: links.map, external: true },
  { icon: "phone", label: tr(ui.labels.phone, lang), value: links.phoneDisplay, href: links.phone, external: false },
  { icon: "mail", label: tr(ui.labels.email, lang), value: settings.email, href: links.email, external: false },
  { icon: "clock", label: tr(ui.labels.hours, lang), value: tr(settings.hours, lang), href: "", external: false },
] as const;
---

{
  sectionVisibility().contacts && (
    <section class="section" id="contacts" aria-labelledby="contacts-title">
      <div class="container">
        <SectionTitle id="contacts-title" lang={lang} head={home.contacts} />
        <div class="contacts">
          <div class="contacts__info glass">
            <ul class="contacts__rows">
              {rows.map((r) => (
                <li class="contacts__row">
                  <span class="icon-box">
                    <Icon name={r.icon} />
                  </span>
                  <span class="contacts__text">
                    <span class="t-body-s c-secondary">{r.label}</span>
                    {r.href ? (
                      <a class="t-label contacts__value" href={r.href} {...externalLink(r.external)}>
                        {r.value}
                      </a>
                    ) : (
                      <span class="t-label contacts__value">{r.value}</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
            <MessengerPair />
            <Btn href={url(lang, "consultation")} icon={null} block>
              {tr(home.hero.button, lang)}
            </Btn>
          </div>

          <div class="map glass-strong">
            <iframe class="map__frame" title={tr(ui.labels.address, lang)} data-src={`${links.mapEmbed}&hl=${lang}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen />
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .contacts {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contacts__info {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 32px 20px;
    border-radius: var(--radius-2xl);
  }

  .contacts__rows {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .contacts__row {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .contacts__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  a.contacts__value:hover {
    color: var(--color-text-accent);
  }

  .map {
    position: relative;
    overflow: hidden;
    height: 260px;
    border-radius: var(--radius-2xl);
    background: var(--color-bg-muted);
  }

  .map__frame {
    width: 100%;
    height: 100%;
    border: 0;
    filter: var(--map-filter);
  }

  @media (min-width: 600px) {
    .contacts__info {
      padding: 32px;
    }

    .map {
      height: 360px;
    }
  }

  @media (min-width: 900px) {
    .contacts {
      flex-direction: row;
      align-items: stretch;
    }

    .contacts__info {
      flex: none;
      width: 400px;
    }

    .map {
      flex: 1;
      height: auto;
      min-height: 440px;
    }
  }
</style>
