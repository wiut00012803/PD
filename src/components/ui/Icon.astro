---
import { SOCIAL_ICONS, UI_ICONS } from "../../icons/icons.ts";
import type { SocialIconName, UiIconName } from "../../icons/icons.ts";

type Props = ({ name: UiIconName; social?: never } | { social: SocialIconName; name?: never }) & {
  size?: number;
  class?: string;
};

const { name, social, size, class: className } = Astro.props;
const body = social ? SOCIAL_ICONS[social] : UI_ICONS[name as UiIconName];
if (!body) throw new Error(`Иконка «${name ?? social}» не найдена — выполните npm run icons:generate`);
const paint: Record<string, string> = social ? { fill: "currentColor" } : { fill: "none", stroke: "currentColor", "stroke-width": "1.5", "stroke-linecap": "round", "stroke-linejoin": "round" };
---

<svg
  class:list={["icon", `icon--${name ?? social}`, className]}
  style={size ? `--icon-size:${size}px` : undefined}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  {...paint}
  set:html={body}
/>
