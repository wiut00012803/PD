---
import Messenger from "./Messenger.astro";

interface Props {
  inlineFromTablet?: boolean;
  class?: string;
}

const { inlineFromTablet = false, class: className } = Astro.props;
---

<div class:list={["messenger-pair", inlineFromTablet && "messenger-pair--inline", className]}>
  <Messenger platform="telegram" block />
  <Messenger platform="whatsapp" block />
</div>

<style>
  .messenger-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media (min-width: 600px) {
    .messenger-pair--inline {
      display: flex;
    }

    .messenger-pair--inline :global(.btn) {
      width: auto;
    }
  }
</style>
