---
import Icon from "./Icon.astro";
import type { UiIconName } from "../../icons/icons.ts";
import { externalLink } from "../../lib/html.ts";

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "m" | "s";
  icon?: UiIconName | null;
  iconStart?: UiIconName;
  external?: boolean;
  block?: boolean;
  class?: string;
  [attr: string]: unknown;
}

const { href, variant = "primary", size = "m", icon = variant === "secondary" ? null : "arrow-right", iconStart, external = false, block = false, class: className, ...rest } = Astro.props;
const Tag = href ? "a" : "button";
const tagAttrs: Record<string, string> = href ? { href, ...externalLink(external) } : { type: "button" };
---

<Tag class:list={["btn", `btn--${variant}`, `btn--${size}`, block && "btn--block", className]} {...tagAttrs} {...rest}>
  {iconStart && <Icon name={iconStart} />}
  <span><slot /></span>
  {icon && <Icon name={icon} />}
</Tag>
