---
import Logo from "./ui/Logo.astro";
import Icon from "./ui/Icon.astro";
import Btn from "./ui/Btn.astro";
import LangSwitch from "./ui/LangSwitch.astro";
import ThemeToggle from "./ui/ThemeToggle.astro";
import Messenger from "./ui/Messenger.astro";
import MessengerPair from "./ui/MessengerPair.astro";
import { navLinks } from "../lib/nav.ts";
import { tr, url } from "../lib/i18n.ts";
import type { Lang, PageKey } from "../lib/i18n.ts";
import { getContent } from "../lib/content.ts";

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const { ui, settings } = getContent();
const links = navLinks(lang, page);
---

<dialog id="site-menu" class="menu" aria-label={tr(ui.buttons.menu, lang)} data-menu>
  <div class="menu__inner container">
    <div class="menu__head">
      <a href={url(lang, "home")} aria-label={settings.siteName} data-menu-close-link>
        <Logo label={settings.siteName} />
      </a>
      <button type="button" class="round-btn menu__close" data-menu-close aria-label={tr(ui.buttons.close, lang)}>
        <Icon name="x" size={22} />
      </button>
    </div>

    <nav class="menu__links">
      {
        links.map((l) => (
          <a href={l.href} class="menu__link" data-menu-close-link>
            <span class="t-h3">{l.label}</span>
            <Icon name="arrow-right" size={22} />
          </a>
        ))
      }
    </nav>

    <div class="menu__actions">
      <div class="menu__prefs">
        <LangSwitch lang={lang} page={page} touch />
        <ThemeToggle lang={lang} touch />
      </div>
      <Btn href={url(lang, "consultation")} block data-menu-close-link>
        {tr(ui.nav.consultation, lang)}
      </Btn>
      <MessengerPair />
      <Messenger platform="phone" block />
    </div>
  </div>
</dialog>

<style>
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bg-page);
    color: var(--color-text-primary);
    overflow-y: auto;
    overscroll-behavior: contain;
    --logo-h: 40px;
  }

  .menu[open] {
    animation: menu-in 280ms var(--ease-out);
  }

  .menu::backdrop {
    background: var(--color-bg-page);
  }

  .menu::before {
    content: "";
    position: fixed;
    left: 5%;
    top: -35vw;
    width: 90%;
    height: 45vw;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--color-glow-primary), transparent);
    opacity: var(--glow-opacity);
    filter: blur(40px);
    pointer-events: none;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .menu__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-bottom: calc(24px + env(safe-area-inset-bottom));
  }

  .menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--header-top);
    min-height: calc(var(--header-top) + var(--header-h));
  }

  .menu__close {
    --round-size: 48px;
  }

  .menu__links {
    display: flex;
    flex-direction: column;
    padding-top: 24px;
  }

  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--color-separator);
    color: var(--color-text-primary);
  }

  .menu__link .t-h3 {
    font-size: 24px;
  }

  .menu__link :global(.icon) {
    color: var(--color-icon-secondary);
  }

  .menu__actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 28px;
  }

  .menu__prefs {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  @media (min-width: 600px) {
    .menu__links {
      padding-top: 40px;
    }

    .menu__link {
      padding-block: 18px;
    }

    .menu__link .t-h3 {
      font-size: var(--fs-h3);
    }
  }
</style>
