---
import logoSvg from "../../assets/brand/logo-horizontal.svg?raw";
import { nextLogoId } from "../../lib/logo-ids.ts";
import { escapeHtml } from "../../lib/html.ts";

interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
const suffix = nextLogoId();
const svg = logoSvg
  .replace(/<\?xml[^>]*>/, "")
  .replace(/\bid="([^"]+)"/g, (_m, id: string) => `id="${id}-${suffix}"`)
  .replace(/url\(#([^)]+)\)/g, (_m, id: string) => `url(#${id}-${suffix})`)
  .replace(/<svg\b([^>]*)>/, (_m, attrs: string) => `<svg${attrs.replace(/\s(width|height)="[^"]*"/g, "")} class="logo__svg" role="img" aria-label="${escapeHtml(label)}" focusable="false">`);
---

<span class:list={["logo", className]}>
  <Fragment set:html={svg} />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    height: var(--logo-h, 34px);
    color: var(--color-text-primary);
  }

  .logo :global(.logo__svg) {
    height: 100%;
    width: auto;
    overflow: visible;
  }
</style>
